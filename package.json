{
  "name": "homechef-ai",
  "version": "7.4.0",
  "private": true,
  "description": "SousChef v7.4 — KLE Pillars 3–4: Skill Growth + Household Identity Learner.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/dish-corpus/build-search-pack.mjs && tsx scripts/build-search-index.ts && tsx scripts/build-sitemap.ts && vite build",
    "search:index": "tsx scripts/build-search-index.ts",
    "sitemap": "tsx scripts/build-sitemap.ts",
    "preview": "vite preview",
    "netlify:dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test:knowledge": "tsx --test tests/knowledge.test.mjs",
    "knowledge:import": "node scripts/import-taxonomy-to-knowledge.mjs",
    "knowledge:generate": "node scripts/generate-pantry-knowledge.mjs",
    "knowledge:variants": "node scripts/generate-variant-nodes.mjs",
    "knowledge:depth": "tsx scripts/generate-ingredient-depth.ts",
    "knowledge:dishes": "node scripts/generate-dish-corpus.mjs",
    "knowledge:search-pack": "node scripts/dish-corpus/build-search-pack.mjs",
    "knowledge:embed-shards": "node scripts/dish-corpus/build-embed-shards.mjs",
    "knowledge:training": "node scripts/generate-training-kitchen.mjs",
    "knowledge:all": "npm run knowledge:generate && npm run knowledge:variants && npm run knowledge:depth && npm run knowledge:dishes && npm run knowledge:search-pack && npm run knowledge:training",
    "db:init": "node scripts/init-db.mjs",
    "env:netlify": "node scripts/sync-netlify-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "stripe": "^17.7.0",
    "uuid": "^11.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "netlify-cli": "^19.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "engines": {
    "node": ">=20"
  }
}
