# OpenAI — server-side only (Netlify functions; never expose to frontend)
OPENAI_API_KEY=sk-your-key-here

# Supabase — https://supabase.com/dashboard/project/xqvtnzfnjjsqgtcpkxbz/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # REQUIRED on Netlify for functions (credits, quotas, billing webhook)

# Stripe — optional until billing enabled (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_FAMILY=price_...

# Frontend (Vite — must be set in Netlify for production builds)
VITE_APP_NAME=HomeChef AI
VITE_API_BASE=/.netlify/functions
VITE_SITE_URL=https://home-chef-ai.netlify.app
VITE_ENABLE_BILLING=false

# Server runtime (Netlify functions)
USE_DEV_STORE=false
ENABLE_BILLING=false
FOUNDER_EMAILS=you@example.com

# Agent Suite v6 — optional toggles (default: enabled when OPENAI_API_KEY is set)
# AGENT_V6_PHASE2=false
# AGENT_V6_PHASE3=false
# AGENT_V6_HYBRID=false
# AGENT_V6_STREAM=false
# AGENT_V6_EXPERT_MODE=council

# Local dev only — do NOT set on Netlify (functions bundle data/ai via netlify.toml included_files)
# KNOWLEDGE_ROOT=H:/HomeChefAi/data/ai
