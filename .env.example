# OpenAI — required for receipt parsing, meal planning, assistant
OPENAI_API_KEY=sk-your-key-here

# Neon Postgres (Netlify DB) — set in Netlify dashboard for production
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# App
VITE_APP_NAME=HomeChef AI
VITE_API_BASE=/.netlify/functions

# Dev fallback — uses local JSON store when DATABASE_URL is unset
USE_DEV_STORE=true
